{
	"name": "site-archive",
	"version": "2.2.4",
	"description": "Website capture tool written in TS using Puppeteer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mirite/site-archive.git"
	},
	"license": "MIT",
	"author": "Jesse Conner <me@jesseconner.ca>",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/types/index.d.ts",
				"default": "./dist/esm/index.mjs"
			},
			"require": {
				"types": "./dist/cjs/types/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"types": "./dist/esm/types/index.d.ts",
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"build": "yarn run clean && yarn run build:esm && yarn run build:cjs",
		"build:cjs": "tsc -p ./configs/tsconfig.cjs.json",
		"build:esm": "tsc -p ./configs/tsconfig.esm.json && move-file dist/esm/index.js dist/esm/index.mjs",
		"check": "tsc --noEmit",
		"clean": "del-cli ./dist",
		"format": "prettier . --write --cache",
		"lint": "eslint --fix --cache",
		"release": "yarn build && yarn npm publish",
		"test": "yarn build && node ./dist/test.js https://rootree.ca"
	},
	"dependencies": {
		"html-urls": "^2.4.67",
		"jsdom": "^29.1.1",
		"puppeteer": "^25.1.0",
		"tar": "^7.5.16",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@mirite/eslint-config-mirite": "^2.1.1",
		"@types/node": "^25.9.3",
		"@types/tar": "^7.0.87",
		"del-cli": "^7.0.0",
		"eslint": "^10.4.1",
		"move-file-cli": "^3.0.0",
		"prettier": "^3.8.4"
	},
	"packageManager": "yarn@4.16.0",
	"engines": {
		"node": ">=18.0.0"
	}
}
